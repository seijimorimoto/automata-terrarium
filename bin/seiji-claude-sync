#!/usr/bin/env bash
# seiji-claude-sync — run every per-category sync in order.
#
# Order: skills -> hooks -> settings. Settings runs last so that any hook
# registrations referencing scripts have the script files in place first.
# Pass --dry-run to preview without writing.
set -euo pipefail

DRY_RUN=()
for arg in "$@"; do
  case "$arg" in
    --dry-run) DRY_RUN=(--dry-run) ;;
    -h|--help)
      cat <<'EOF'
Usage: seiji-claude-sync [--dry-run]

Runs every per-category sync in order:
  1. seiji-claude-sync-skills
  2. seiji-claude-sync-hooks
  3. seiji-claude-sync-settings

Pass --dry-run to preview without writing. Settings runs last so any hook
registrations land after their script files are in place.
EOF
      exit 0
      ;;
    *)
      echo "seiji-claude-sync: unknown argument: $arg" >&2
      exit 2
      ;;
  esac
done

SCRIPT_PATH="$(readlink -f "$0")"
SCRIPT_DIR="$(dirname "$SCRIPT_PATH")"

run_step() {
  local label="$1"
  local script="$SCRIPT_DIR/$1"
  if [ ! -x "$script" ] && [ ! -f "$script" ]; then
    echo "seiji-claude-sync: missing $label" >&2
    exit 1
  fi
  echo "==> $label"
  "$script" "${DRY_RUN[@]}"
}

run_step "seiji-claude-sync-skills"
run_step "seiji-claude-sync-hooks"
run_step "seiji-claude-sync-settings"

echo "==> done"
