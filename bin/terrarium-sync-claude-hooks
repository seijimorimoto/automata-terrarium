#!/usr/bin/env bash
# terrarium-sync-claude-hooks — copy each <repo>/hooks/<name>/ to ~/.claude/hooks/<name>/
# Use --dry-run to preview without writing.
#
# This script copies hook scripts only. It does NOT register hooks in
# ~/.claude/settings.json — that responsibility belongs to
# terrarium-sync-claude-settings, which merges settings/*.json presets.
set -euo pipefail

DRY_RUN=0
for arg in "$@"; do
  case "$arg" in
    --dry-run) DRY_RUN=1 ;;
    -h|--help)
      cat <<'EOF'
Usage: terrarium-sync-claude-hooks [--dry-run]

Copies each subfolder of <repo>/hooks/ to ~/.claude/hooks/<name>/.
Existing destination folders are removed before copy so deletions in the
source propagate. With --dry-run, prints planned actions without writing.

This script copies scripts only — it does NOT register hooks in
~/.claude/settings.json. Use terrarium-sync-claude-settings for that.
EOF
      exit 0
      ;;
    *)
      echo "terrarium-sync-claude-hooks: unknown argument: $arg" >&2
      exit 2
      ;;
  esac
done

SCRIPT_PATH="$(readlink -f "$0")"
SCRIPT_DIR="$(dirname "$SCRIPT_PATH")"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
SRC_DIR="$REPO_ROOT/hooks"
DST_DIR="$HOME/.claude/hooks"

if [ ! -d "$SRC_DIR" ]; then
  echo "terrarium-sync-claude-hooks: source not found: $SRC_DIR" >&2
  exit 1
fi

if [ "$DRY_RUN" -eq 0 ]; then
  mkdir -p "$DST_DIR"
fi

count=0
for src in "$SRC_DIR"/*/; do
  [ -d "$src" ] || continue
  name="$(basename "$src")"
  dst="$DST_DIR/$name"
  if [ "$DRY_RUN" -eq 1 ]; then
    echo "[dry-run] sync hook '$name': $src -> $dst"
  else
    rm -rf "$dst"
    cp -R "$src" "$dst"
    echo "synced hook '$name'"
  fi
  count=$((count + 1))
done

if [ "$DRY_RUN" -eq 1 ]; then
  echo "[dry-run] would sync $count hook(s) to $DST_DIR"
else
  echo "synced $count hook(s) to $DST_DIR"
fi
